# Copy to .env and fill in. No real production value belongs here.

DEBUG=True
SECRET_KEY=change-me-generate-a-unique-key-per-environment
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Admin path, moved off its well-known default outside development.
ADMIN_URL=admin/

# Allows `manage.py seed_demo`, the fictitious events of the mockup. Never in production.
DEMO_DATA_ENABLED=true

# PostgreSQL. Leave POSTGRES_HOST empty to use the local Unix socket.
POSTGRES_DB=cdf2
POSTGRES_USER=cdf2
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
