# Copy to .env and fill in. No real production value belongs here.

DEBUG=True
SECRET_KEY=change-me-generate-a-unique-key-per-environment
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Admin path, moved off its well-known default outside development.
ADMIN_URL=admin/

# Allows `manage.py seed_demo`, the fictitious events of the mockup. Never in production.
DEMO_DATA_ENABLED=true

# Private files (deposited documents), outside the web root. The repository's
# private/ folder when left out; required on the server (shared/private).
# MEDIA_ROOT=/path/to/private
# The largest file a member may deposit, in bytes (15 MB when left out). Keep it
# below nginx's client_max_body_size.
# DOCUMENT_MAX_SIZE=15728640

# PostgreSQL. Leave POSTGRES_HOST empty to use the local Unix socket.
POSTGRES_DB=cdf2
POSTGRES_USER=cdf2
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
