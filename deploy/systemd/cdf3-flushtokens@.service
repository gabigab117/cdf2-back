# Purge of the expired refresh tokens of the Comité des fêtes v2 API, one
# instance per environment, started every night by cdf3-flushtokens@.timer.
[Unit]
Description=Comité des fêtes v2 token purge (%i)
Documentation=https://github.com/gabigab117/cdf2-back
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=cdf3
Group=cdf3
WorkingDirectory=/var/www/cdf3/%i/back/current
EnvironmentFile=/var/www/cdf3/%i/shared/back.env
# manage.py defaults to the development settings.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/var/www/cdf3/%i/back/current/.venv/bin/python manage.py flushexpiredtokens

# Confined like the API, without any writable path: the purge only talks to
# PostgreSQL, over its local socket.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# The server is shared with other production sites.
MemoryMax=256M
CPUWeight=20
