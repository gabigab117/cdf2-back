# API of the Comité des fêtes v2, one instance per environment:
# cdf3-api@preprod.service, cdf3-api@prod.service.
[Unit]
Description=Comité des fêtes v2 API (%i)
Documentation=https://github.com/gabigab117/cdf2-back
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=cdf3
Group=cdf3
WorkingDirectory=/var/www/cdf3/%i/back/current
EnvironmentFile=/var/www/cdf3/%i/shared/back.env
ExecStart=/var/www/cdf3/%i/back/current/.venv/bin/gunicorn config.wsgi --bind ${GUNICORN_BIND} --workers 2 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5s

# The service reads its release and only writes the private files.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/www/cdf3/%i/shared/private

# The server is shared with other production sites.
MemoryMax=512M
CPUWeight=20

[Install]
WantedBy=multi-user.target
